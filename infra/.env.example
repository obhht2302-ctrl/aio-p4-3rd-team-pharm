# 복사해서 infra/.env 로 쓰고 값을 채움. .env 는 커밋하지 않음 (키 · 코드 값은 팀장에게).
SAM_DATA_API=/home/<나>/aio-01d4-stu/Last3Mon/77/data-api/server.py   # 80일차 키트가 나오면 Last3Mon/80
N8N_NETWORK=day65-n8n_default
BIND_HOST=127.0.0.1          # 노트북은 127.0.0.1, 팀 VM은 팀장이 정함
DATA_API_PORT=8800
API_PORT=8000
WEB_PORT=3000

# api (FastAPI)
TEAM3_ENTRY_CODE=<입장 코드>
TEAM3_API_KEY=<n8n team3-handoff 가 POST /tickets 에 보낼 키>
N8N_WEBHOOK_URL=http://n8n:5678/webhook/team3-support
N8N_WEBHOOK_KEY=<팀 웹훅 Header Auth 키>
N8N_TIMEOUT=15
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=                # 비우면 메모리 저장소. PgStore 가 생기면 postgresql://team3:<DB_PASSWORD>@db:5432/team3
DB_PASSWORD=<db 프로필을 켤 때만>
