# 처음엔 bash tools/setup.sh 가 이 파일을 infra/.env 로 복사해 줌. infra/.env 는 git에 올라가지 않음.
# ── 디코로 받은 값만 여기에 붙여 넣기 (아래는 그대로 둬도 됨) ──
TEAM3_KEY=                   # 팀 키 (웹훅 X-Team-Key · API X-Api-Key 공용)
OPENAI_API_KEY=              # 우리 조 OpenAI 키 (비우면 수업 때 넣은 'OpenAI (.env)'를 그대로 씀)

# ── 보통은 안 고쳐도 됨 ──
# SAM_DATA_API=              # 샘 data-api server.py. 비우면 ~/aio-01d4-stu/Last3Mon/77/data-api/server.py (두 레포를 홈 폴더에 받았을 때)
N8N_NETWORK=day65-n8n_default
BIND_HOST=127.0.0.1          # 노트북은 127.0.0.1, 팀 VM은 팀장이 정함
DATA_API_PORT=8800
API_PORT=8000
WEB_PORT=3000

# api (FastAPI) — 팀 키는 위 TEAM3_KEY 를 compose가 넘겨 줌
TEAM3_ENTRY_CODE=            # 화면 입장 코드 (비우면 검사 안 함)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/team3-support
N8N_TIMEOUT=15
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=                # 비우면 메모리 저장소. PgStore 가 생기면 postgresql://team3:<DB_PASSWORD>@db:5432/team3
DB_PASSWORD=                 # db 프로필을 켤 때만
