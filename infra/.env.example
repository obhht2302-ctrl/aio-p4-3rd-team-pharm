# 처음엔 bash tools/setup.sh가 이 파일을 infra/.env로 복사해요. infra/.env는 git에 올라가지 않아요.
# ── 디코로 받은 팀 키만 여기에 붙여 넣으세요 (나머지는 그대로 둬도 돼요) ──
TEAM3_KEY=                   # 팀 키 (웹훅 X-Team-Key와 API X-Api-Key에 같이 써요)

# ── 보통은 안 고쳐도 돼요 ──
# OPENAI_API_KEY=            # 팀 VM에서 리드만 씀. 비워 두면 수업 때 각자 넣은 'OpenAI (.env)'를 그대로 써요
# SAM_DATA_API=              # 샘 data-api server.py 경로. 비워 두면 ~/aio-01d4-stu/Last3Mon/77/data-api/server.py를 써요 (두 레포를 홈 폴더에 받았을 때)
N8N_NETWORK=day65-n8n_default
BIND_HOST=127.0.0.1          # 노트북은 127.0.0.1, 팀 VM은 팀장이 정해요
DATA_API_PORT=8800
API_PORT=8000
WEB_PORT=3000
WEB_BIND=127.0.0.1           # 화면만 밖에 열 때 (팀 VM: 0.0.0.0 + WEB_PORT=80). data-api · api는 BIND_HOST 그대로

# api (FastAPI) — 팀 키는 compose가 위 TEAM3_KEY 값을 넘겨요
TEAM3_ENTRY_CODE=            # 화면 입장 코드 (비워 두면 검사하지 않아요)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/team3-support
N8N_TIMEOUT=15
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=                # 비워 두면 메모리에 저장해요. PgStore가 생기면 postgresql://team3:<DB_PASSWORD>@db:5432/team3
DB_PASSWORD=                 # db 프로필을 켤 때만 써요
