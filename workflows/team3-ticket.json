      "typeVersion": 3.4,
      "position": [
        1100,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f0",
              "name": "ok",
              "value": "={{ !$json.error }}",
              "type": "boolean"
            },
            {
              "id": "f1",
              "name": "mode",
              "value": "practice",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "fallback",
              "value": "={{ $('설정').item.json.mode === 'real' }}",
              "type": "boolean"
            },
            {
              "id": "f3",
              "name": "ticketKey",
              "value": "={{ $json.error ? null : ($json.key || $('설정').item.json.key) }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "error",
              "value": "={{ $json.error ? ($json.error.message || String($json.error)) : null }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    }
