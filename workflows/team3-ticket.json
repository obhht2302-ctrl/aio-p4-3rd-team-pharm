      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.mode }}",
              "rightValue": "real",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000004-3a3a-4000-8000-000000000000",
      "name": "Jira 요청 생성",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://aio3-servicedesk.atlassian.net/rest/servicedeskapi/request",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ serviceDeskId: $json.serviceDeskId, requestTypeId: $json.requestTypeId, requestFieldValues: { summary: $json.title, description: ($json.description || '') + '\\n\\n요청자: ' + $json.requester + ' / 분류: ' + $json.category + ' / 우선순위: ' + $json.priority + ' / 키: ' + $json.key } }) }}",
        "options": {
          "timeout": 10000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi"
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "jiraAio3Cloud001",
          "name": "Jira Cloud (aio3-servicedesk)"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "00000005-3a3a-4000-8000-000000000000",
      "name": "연습용 티켓 생성",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://data-api:8800/tickets",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ key: $('설정').item.json.key, title: $('설정').item.json.title, requester: $('설정').item.json.requester, category: $('설정').item.json.category, priority: $('설정').item.json.priority }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "00000006-3a3a-4000-8000-000000000000",
      "name": "결과(Jira)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f0",
              "name": "ok",
              "value": "={{ true }}",
              "type": "boolean"
            },
            {
              "id": "f1",
              "name": "mode",
              "value": "real",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "fallback",
              "value": "={{ false }}",
              "type": "boolean"
            },
            {
              "id": "f3",
              "name": "ticketKey",
              "value": "={{ $json.issueKey }}",
              "type": "string"
            },
            {
              "id": "f4",
