            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c0",
              "leftValue": "={{ $json.mode }}",
              "rightValue": "real",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00000004-3a3a-4000-8000-000000000000",
      "name": "Slack 알림",
