          "__rl": true,
          "mode": "id",
          "value": "={{ $json.channelId }}"
        },
        "messageType": "text",
        "text": "={{ ({critical: '🔴', error: '🔴', warning: '🟠'}[$json.severity] || '🔵') + ' *[' + $json.severity + ']* ' + $json.workflow + ' › ' + $json.node + '\\n' + $json.message }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "credentials": {
        "slackApi": {
          "id": "slackAio3Bot0001",
          "name": "Slack aio team3 (support-bot)"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "00000005-3a3a-4000-8000-000000000000",
      "name": "연습용 알림",
