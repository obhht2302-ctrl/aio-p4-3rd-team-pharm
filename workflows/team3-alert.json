      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://data-api:8800/alerts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: $('설정').item.json.workflow, node: $('설정').item.json.node, message: $('설정').item.json.message, severity: $('설정').item.json.severity }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000
    },
    {
      "id": "00000006-3a3a-4000-8000-000000000000",
      "name": "결과(Slack)",
