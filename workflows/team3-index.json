{
 "name": "team3-index",
 "nodes": [
  {
   "name": "Index webhook",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2,
   "position": [
    0,
    300
   ],
   "parameters": {
    "httpMethod": "POST",
    "path": "team3-index",
    "responseMode": "responseNode",
    "options": {}
   }
  },
  {
   "name": "Index settings",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    200,
    300
   ],
   "parameters": {
    "jsCode": "// 색인 설정. 요청 body: {} 또는 {\"chunking\": \"section\" | 300, \"overlap\": 50}\n// memoryKey는 Store 노드에 글자로 둠 (pharm_kb_v1_all · pharm_kb_v1_owner). 버전을 올리면 두 Store 노드와 여기를 함께 바꿈.\nconst body = $('Index webhook').first().json.body ?? {};\nconst chunking = body.chunking ?? 'section';\nconst overlap = chunking === 'section' ? 0 : Number(body.overlap ?? 50);\nreturn [{ json: { kb_version: 'pharm_kb_v1', chunking, overlap, t0: Date.now() } }];"
   }
  },
  {
   "name": "List docs",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    400,
    300
   ],
   "parameters": {
    "url": "http://data-api:8800/docs",
    "options": {}
   }
  },
  {
   "name": "One item per doc",
   "type": "n8n-nodes-base.splitOut",
   "typeVersion": 1,
   "position": [
    600,
    300
   ],
   "parameters": {
    "fieldToSplitOut": "docs",
    "options": {}
   }
  },
  {
   "name": "Get doc",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    800,
    300
   ],
   "parameters": {
    "url": "=http://data-api:8800/docs/{{ $json.name }}",
    "options": {}
   }
  },
  {
   "name": "Make chunks",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1000,
    300
   ],
   "parameters": {
    "jsCode": "// 문서마다 ## 절로 나누고, chunking이 숫자면 절 안을 글자 수로 다시 자름 (overlap만큼 앞 조각 끝을 붙임).\n// 청크 앞머리 = \"문서 제목 › 절 제목\" (71일차: 붙이면 문서를 더 잘 찾음).\nconst s = $('Index settings').first().json;\nconst TYPES = ['closing', 'recall', 'senior', 'billing', 'stockout'];\nconst chunks = [];\nfor (const item of $input.all()) {\n  const { name, title, text } = item.json;\n  const access_level = name.startsWith('mgr-') ? 'owner' : 'all';\n  const prefix = name.split('-')[0];\n  const type = TYPES.includes(prefix) ? prefix : 'core';\n  const sections = text.split(/\\n(?=## )/).slice(1);            // 첫 덩어리(# 제목)는 버림\n  sections.forEach((piece, i) => {\n    const section = piece.split('\\n')[0].replace(/^##\\s*/, '').trim();\n    const body = piece.split('\\n').slice(1).join('\\n').trim();\n    let parts;\n    if (s.chunking === 'section') parts = [body];\n    else {\n      const size = Number(s.chunking), step = Math.max(1, size - s.overlap);\n      parts = [];\n      for (let k = 0; k < body.length; k += step) { parts.push(body.slice(k, k + size)); if (k + size >= body.length) break; }\n    }\n    parts.forEach((p, j) => chunks.push({ json: {\n      doc: name, title, section, chunk: `${i + 1}.${j + 1}`, access_level, kb_version: s.kb_version, type,\n      text: `${title} › ${section}\\n${p}` } }));\n  });\n}\nreturn chunks;"
   }
  },
  {
   "name": "By access",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1200,
    300
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "strict",
      "version": 2
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.access_level }}",
       "rightValue": "owner",
       "operator": {
        "type": "string",
        "operation": "equals"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "name": "Store owner",
   "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
   "typeVersion": 1.3,
   "position": [
    1440,
    200
   ],
   "parameters": {
    "mode": "insert",
    "memoryKey": {
     "__rl": true,
     "mode": "list",
     "value": "pharm_kb_v1_owner",
     "cachedResultName": "pharm_kb_v1_owner"
    },
    "clearStore": true
   }
  },
