   ],
   "parameters": {
    "model": "text-embedding-3-large",
    "options": {}
   },
   "credentials": {
    "openAiApi": {
     "id": "openAiCourse0001",
     "name": "OpenAI (.env)"
    }
   }
  },
  {
   "name": "Chunk loader owner",
   "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
   "typeVersion": 1.1,
   "position": [
    1560,
    20
   ],
   "parameters": {
    "jsonMode": "expressionData",
    "jsonData": "={{ $json.text }}",
    "textSplittingMode": "simple",
    "options": {
     "metadata": {
      "metadataValues": [
       {
        "name": "doc",
        "value": "={{ $json.doc }}"
       },
