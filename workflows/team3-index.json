        "value": "={{ $json.type }}"
       }
      ]
     }
    }
   }
  },
  {
   "name": "Chunk loader all",
   "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
   "typeVersion": 1.1,
   "position": [
    1560,
    640
   ],
   "parameters": {
    "jsonMode": "expressionData",
    "jsonData": "={{ $json.text }}",
    "textSplittingMode": "simple",
    "options": {
     "metadata": {
      "metadataValues": [
       {
