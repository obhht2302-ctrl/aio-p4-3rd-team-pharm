    {
      "parameters": {
        "jsCode": "// data-api 응답을 계약 모양으로 바꾼다. 이 노드 하나가 성공 · 실패 · 중복을 모두 정리한다.\nconst s = $('Handoff settings').first().json;\nconst req = $('Prepare request').first().json;\nconst raw = $json;\nconst body = raw.body ?? raw;\nconst status = raw.statusCode ?? raw.httpCode ?? raw.error?.statusCode ?? raw.error?.httpCode ?? (raw.error ? 500 : 200);\nconst errText = JSON.stringify(raw.error || raw);\nconst authFailed = status === 401 || status === 403 || /\\b(401|403)\\b/.test(errText);\nconst ok = (status === 200 || status === 201) && !!body.ticket_id;\nconst reason = ok ? '' : (authFailed ? 'auth_failed' : 'tickets_down');\nconst ticket = ok ? { ticket_id: body.ticket_id, priority: req.priority, duplicate: body.duplicate === true } : null;\nconst alert = ok ? (req.priority === 'high' && body.duplicate !== true) : true;\nreturn [{ json: {\n  ...req,\n  mode: s.mode,\n  t0: s.t0,\n  ticket,\n  reason,\n  dlq: !ok,\n  alert,\n  alert_reason: ok ? 'urgent' : reason,\n  failure: !ok,\n  extras: { screen: 'skipped', slack: 'skipped', jira: 'skipped' },\n} }];"
      },
