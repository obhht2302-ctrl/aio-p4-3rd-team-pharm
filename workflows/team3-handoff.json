        "jsCode": "// 화면은 덧붙임이라 실패해도 응답을 막지 않는다. extras.screen만 표시한다.\nconst base = $('Ticket outcome').first().json;\nconst raw = $json;\nconst status = raw.statusCode ?? raw.error?.statusCode ?? (raw.error ? 500 : 200);\nreturn [{ json: { ...base, extras: { ...base.extras, screen: (status >= 200 && status < 300) ? 'ok' : 'failed' } } }];"
