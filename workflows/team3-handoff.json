    {
      "parameters": {
        "jsCode": "// 실제/연습 스위치 한 곳. Slack · Jira만 실제로 부를지 정한다. 손님 문자 · 메일은 어떤 모드에서도 보내지 않는다.\nconst settings = {\n  mode: 'practice',\n  api_url: 'http://api:8000',\n  ticket_timeout: 2000,\n  ticket_tries: 3,\n  ticket_wait: 500,\n  extra_timeout: 2000,\n  t0: Date.now(),\n};\nreturn [{ json: settings }];"
      },
      "id": "h2-settings",
      "name": "Handoff settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-760, 300]
    },
    {
      "parameters": {
        "jsCode": "// 본체가 보낸 요청을 정리한다. 제목 · 요약의 전화 · 메일은 티켓 · 알림 · DLQ로 가기 전에 여기서 가린다.\nconst hook = $('Handoff webhook').first().json;\nconst b = hook.body ?? hook;\nconst s = $('Handoff settings').first().json;\nconst mask = (v) => String(v || '')\n  .replace(/01[016789]-?\\d{3,4}-?(\\d{4})/g, (_m, last) => `010-****-${last}`)\n  .replace(/([A-Za-z0-9._%+-])[A-Za-z0-9._%+-]*@([A-Za-z0-9.-]+\\.[A-Za-z]{2,})/g, (_m, a, d) => `${a}***@${d}`);\nconst request_id = String(b.request_id || `handoff-${Date.now()}`);\nconst title = mask(b.title || '').slice(0, 80);\nconst summary = mask(b.summary || '');\nreturn [{ json: {\n  request_id,\n  user: String(b.user || ''),\n  type: String(b.type || 'other'),\n  title,\n  assignee: String(b.assignee || 'owner'),\n  priority: String(b.priority || 'normal'),\n  reason: String(b.reason || 'needs_person'),\n  summary,\n  product: String(b.product || ''),\n  mode: s.mode,\n  api_url: s.api_url,\n  t0: s.t0,\n} }];"
      },
      "id": "h3-prepare",
      "name": "Prepare request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-540, 300]
    },
