{
  "id": "team3Errors00001",
  "name": "team3-errors",
  "nodes": [
    {
      "parameters": {},
      "id": "e1-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [-900, 300]
    },
    {
      "parameters": {
        "jsCode": "// 실제/연습 스위치. 기본은 연습이라 Jira를 부르지 않는다.\nreturn [{ json: { mode: 'practice', t0: Date.now() } }];"
      },
      "id": "e2-settings",
      "name": "Error settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-680, 300]
    },
    {
      "parameters": {
        "jsCode": "// Error Trigger가 준 실행 정보를 알림 · DLQ 모양으로 정리한다. 메시지는 앞 200자, 연락처는 가린다.\nconst e = $('Error Trigger').first().json || {};\nconst w = e.workflow || {};\nconst ex = e.execution || {};\nconst err = ex.error || {};\nconst s = $('Error settings').first().json;\nconst mask = (v) => String(v || '')\n  .replace(/01[016789]-?\\d{3,4}-?(\\d{4})/g, (_m, last) => `010-****-${last}`)\n  .replace(/([A-Za-z0-9._%+-])[A-Za-z0-9._%+-]*@([A-Za-z0-9.-]+\\.[A-Za-z]{2,})/g, (_m, a, d) => `${a}***@${d}`);\nreturn [{ json: {\n  workflow: String(w.name || 'unknown'),\n  node: String(ex.lastNodeExecuted || ''),\n  message: mask(err.message || '').slice(0, 200),\n  execution_id: String(ex.id || ''),\n  severity: 'critical',\n  reason: 'unexpected',\n  mode: s.mode,\n  t0: s.t0,\n} }];"
      },
      "id": "e3-details",
      "name": "Error details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://data-api:8800/alerts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({workflow:$json.workflow,node:$json.node,message:$json.message,execution_id:$json.execution_id,severity:'critical',reason:'unexpected'}) }}",
        "options": {
          "timeout": 2000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "e4-alert",
      "name": "Send critical alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-240, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// DLQ에는 실행 id · 워크플로우 · 노드 · 메시지만. 연락처는 이미 Error details에서 가렸다.\nconst d = $('Error details').first().json;\nreturn [{ json: { item: { id: `err-${d.execution_id || Date.now()}`, workflow: d.workflow, node: d.node, message: d.message, severity: 'critical', reason: 'unexpected' } } }];"
      },
      "id": "e4b-dlq-payload",
      "name": "DLQ payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://data-api:8800/dlq",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 2000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "e5-dlq",
      "name": "Send error DLQ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e6-cond",
              "leftValue": "={{ $('Error settings').first().json.mode === 'real' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e6-jira-if",
      "name": "Jira needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "// 장애 티켓은 시스템 오류만. 실행 정보와 메시지만 넘긴다.\nconst d = $('Error details').first().json;\nreturn [{ json: { ...d, mode: 'real', severity: 'critical', summary: `${d.workflow} / ${d.node} 오류` } }];"
      },
      "id": "e7-jira-req",
      "name": "Jira request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 200]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "team3Ticket00001",
          "mode": "id"
        },
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "e8-jira",
      "name": "Call Jira",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [640, 200],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: $json }];"
      },
      "id": "e9-jira-skip",
      "name": "Skip Jira",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 400]
    },
    {
      "parameters": {
        "jsCode": "// 마지막 그물. 응답할 웹훅이 아니라 기록만 남긴다.\nconst d = $('Error details').first().json;\nreturn [{ json: { ok: true, workflow: d.workflow, node: d.node, execution_id: d.execution_id, severity: 'critical' } }];"
      },
      "id": "e10-done",
      "name": "Error done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 300]
    }
  ],
